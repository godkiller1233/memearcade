# Copy to bot/.env and fill in. Both the site and `npm run bot` read this file:
# `npm start` starts the bot with the website as soon as DISCORD_TOKEN is set
# here (or in the server's environment). Set MEMES_BOT_AUTOSTART=off in the
# site's environment (or in this file) if you would rather run the bot elsewhere.
#
# The bot token from https://discord.com/developers/applications -> your app
# -> Bot -> Reset Token. Invite the app to a server with the `bot` and
# `applications.commands` scopes.
DISCORD_TOKEN=

# Only needed when you run the bot by hand (`npm run bot`): the site passes the
# secret it already uses to the bot it starts, so this can stay empty for
# `npm start`. From the arcade: Admin console -> 🤖 Discord bot -> Copy.
# A hand-run bot against a hosted site needs that service's MEMES_BOT_SECRET.
ARCADE_BOT_SECRET=

# Where the arcade lives. A hand-run bot uses this; the site overrides it with
# the port it is actually listening on. Point it at your deployment (https://...)
# when the bot runs somewhere else.
ARCADE_URL=http://127.0.0.1:8787

# Activities (/play) are configured on the website, not here: the site that
# runs the bot needs DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET from the same
# application's OAuth2 page. A hand-run bot pointed at a deployed site uses
# ARCADE_URL above for the browser fallback in its messages.

# Optional: register the slash commands in this server for instant updates.
# Leave empty for global commands (Discord can take up to an hour the first
# time they appear).
DISCORD_GUILD_ID=

# Optional: how long (ms) the bot may trust the feature switches it read from
# the arcade. Commands honour the same switches the website does - a feature
# the owner switched off (or scheduled off) answers with a notice instead of an
# empty board. 0 re-reads them for every command; the default is 10000.
BOT_FEATURE_TTL_MS=10000

# Optional: how often (ms) the bot re-reports the servers it is in, for the
# admin console's server list. It always reports once at boot; the timer is what
# repairs the list after the arcade restarts. Default 300000 (5 minutes).
BOT_GUILD_REPORT_MS=300000
