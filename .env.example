# Memes Arcade - environment settings.
#
# Copy to `.env` and edit. Real environment variables always win over this file,
# so a hosting dashboard (Render, Fly, Railway...) can override anything here.
# `.env` is gitignored - never commit your passwords.

# --- server ---------------------------------------------------------------
# Port. Render/Railway/Fly inject PORT themselves; MEMES_PORT wins if set.
# MEMES_PORT=8787
# Interface to bind. 0.0.0.0 = reachable on your wifi, 127.0.0.1 = this machine only.
# MEMES_HOST=0.0.0.0

# Where accounts, saves and the signing key live. Point this at a mounted disk
# (an absolute path) to keep data across redeploys on a host.
# MEMES_DATA=data

# --- identity -------------------------------------------------------------
# The owner account, seeded on first boot.
# MEMES_ADMIN_USER=memegodmidas
# Leave blank and a random password is generated into data/ADMIN-CREDENTIALS.txt.
# Always set this on a public server, or restarts hand out a new password.
# MEMES_ADMIN_PASS=

# Set to `closed` once your friends have signed up.
# MEMES_REGISTRATIONS=open

# --- links ----------------------------------------------------------------
# Public address used for invite links and the boot banner. Render sets
# RENDER_EXTERNAL_URL automatically, which is used when this is blank.
# MEMES_PUBLIC_URL=https://your-arcade.onrender.com

# --- security -------------------------------------------------------------
# How long a sign-in lasts.
# MEMES_SESSION_DAYS=30
# Largest websocket message (drawing games send big payloads).
# MEMES_MAX_WS=6291456
# How long a party seat survives a disconnect before the member is removed
# (a reload or a brief blip reconnects inside this window).
# MEMES_PARTY_GRACE_MS=20000
# Restrict browser access to specific origins (comma separated). `*` = any.
# MEMES_CORS_ORIGINS=*
# MEMES_CORS=on
# Shared secret that locks /api/admin behind a header on a public server.
# MEMES_ADMIN_TOKEN=

# Stable token for the Discord bot. Without it the secret lives in
# data/bot-secret.txt, which is wiped on hosts with an ephemeral filesystem.
# MEMES_BOT_SECRET=

# --- logging --------------------------------------------------------------
# MEMES_LOG=info

# --- Discord bot (optional) ----------------------------------------------
# DISCORD_TOKEN=
# DISCORD_APP_ID=
# DISCORD_GUILD_ID=
