# Copy to bot/.env and fill in. npm run bot reads this file.
#
# The bot token from https://discord.com/developers/applications -> your app
# -> Bot -> Reset Token. Invite the app to a server with the `bot` and
# `applications.commands` scopes.
DISCORD_TOKEN=

# From the arcade: Admin console -> 🤖 Discord bot -> Copy.
# On a hosted server this is the MEMES_BOT_SECRET you set there.
ARCADE_BOT_SECRET=

# Where the arcade lives. Local play uses the default; point it at your
# deployment (https://...) when the bot runs somewhere else.
ARCADE_URL=http://127.0.0.1:8787

# Optional: register the slash commands in this server for instant updates.
# Leave empty for global commands (Discord can take up to an hour the first
# time they appear).
DISCORD_GUILD_ID=
